# Contact form submission — copy this file to `.env` and fill in the values.

# Endpoint that receives the project brief form as a JSON POST.
#   Formspree:  https://formspree.io/f/your-form-id
#   Web3Forms:  https://api.web3forms.com/submit
VITE_FORM_ENDPOINT=

# Required only by Web3Forms (your access key). Leave empty for Formspree.
VITE_FORM_ACCESS_KEY=
